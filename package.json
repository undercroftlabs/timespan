{
  "name": "@undercroft/timespan-workspace",
  "private": true,
  "description": "Workspace root for the @undercroft/timespan library, the React hook, and the documentation app.",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "postinstall": "husky",
    "build": "node tools/workspace-run.mjs build",
    "typecheck": "node tools/workspace-run.mjs typecheck",
    "lint": "oxlint . && oxfmt --check",
    "lint:fix": "oxlint . && oxfmt",
    "test": "node tools/workspace-test.mjs",
    "bench": "node tools/workspace-run.mjs bench",
    "bench:save": "node tools/timespan-bench.mjs save",
    "bench:compare": "node tools/timespan-bench.mjs compare",
    "sandbox": "node tools/workspace-run.mjs sandbox",
    "size": "node tools/workspace-run.mjs size",
    "dev:docs": "node tools/workspace-run.mjs dev docs",
    "node:versions": "node tools/supported-node-versions.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test --coverage && pnpm run build && pnpm run verify:package",
    "verify:package": "node tools/workspace-run.mjs verify:package"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.0.0",
    "typescript": "catalog:"
  }
}
