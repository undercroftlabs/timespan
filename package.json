{
  "name": "@undercroft/timespan-workspace",
  "private": true,
  "description": "Workspace root for the @undercroft/timespan library and its external bundle tests.",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "postinstall": "husky",
    "build": "pnpm --filter @undercroft/timespan build",
    "lint": "oxlint . && oxfmt --check",
    "test": "pnpm --filter @undercroft/timespan test",
    "test:cov": "pnpm --filter @undercroft/timespan test:cov",
    "test:ci": "pnpm --filter @undercroft/timespan test:ci",
    "test:dist": "pnpm --filter @undercroft/timespan test:dist",
    "test:e2e": "pnpm --filter @undercroft/timespan build && pnpm --filter @undercroft/timespan-bundle-e2e test",
    "test:browser": "pnpm --filter @undercroft/timespan build && pnpm --filter @undercroft/timespan-bundle-e2e test:playwright",
    "test:browser:ui": "pnpm --filter @undercroft/timespan build && pnpm --filter @undercroft/timespan-bundle-e2e test:ui",
    "test:browser:headed": "pnpm --filter @undercroft/timespan build && pnpm --filter @undercroft/timespan-bundle-e2e test:headed",
    "test:browser:report": "pnpm --filter @undercroft/timespan-bundle-e2e test:report",
    "test:browser:docker": "bash tests/bundle-e2e/run-in-docker.sh",
    "check": "./.husky/pre-commit",
    "sandbox": "pnpm --filter @undercroft/timespan sandbox",
    "size": "pnpm --filter @undercroft/timespan size",
    "node:versions": "node tools/supported-node-versions.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.0.0",
    "typescript": "catalog:"
  }
}
