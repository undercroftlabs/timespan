{
  "name": "@undercroft/timespan",
  "version": "1.2.0",
  "description": "Zero-dependency TypeScript library for parsing duration strings and calculating intervals between dates.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "author": "Michael Goodwin <mikejg101@icloud.com>",
  "license": "MIT",
  "homepage": "https://github.com/undercroftlabs/timespan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/undercroftlabs/timespan.git"
  },
  "keywords": [
    "timespan",
    "duration",
    "date",
    "time",
    "datetime",
    "timeframe",
    "interval",
    "javascript",
    "typescript",
    "time parser",
    "time formatter",
    "human-readable",
    "date math",
    "date utilities",
    "date calculation",
    "library",
    "esm",
    "umd",
    "node",
    "browser",
    "undercroft"
  ],
  "bugs": {
    "url": "https://github.com/undercroftlabs/timespan/issues"
  },
  "jest-junit": {
    "outputDirectory": "./reports",
    "outputName": "junit.xml"
  },
  "scripts": {
    "postinstall": "husky",
    "prepublishOnly": "pinst --disable && npm run test:dist",
    "postpublish": "pinst --enable",
    "build": "npm run clean && tsup src/index.ts --dts --format esm,cjs --minify --sourcemap --out-dir dist && npm run build:umd",
    "build:umd": "rollup -c",
    "clean": "ts-node tools/undertools.ts clean",
    "package": "npm run build && npm pack",
    "test:dist": "npm run build && ts-node tools/undertools.ts test:distribution",
    "test": "jest --no-cache --runInBand",
    "test:cov": "jest --coverage --no-cache --runInBand",
    "test:junit": "cross-env JEST_JUNIT_CLASSNAME={filepath} jest --reporters=jest-junit",
    "test:ci": "cross-env JEST_JUNIT_CLASSNAME={filepath} jest --coverage --no-cache --runInBand --reporters=default --reporters=jest-junit",
    "test:browser": "npm run build && playwright test",
    "test:browser:ui": "npm run build && playwright test --ui",
    "test:browser:headed": "npm run build && playwright test --headed",
    "test:browser:report": "playwright show-report",
    "test:browser:docker": "bash tests/browser/run-in-docker.sh",
    "test:browser:container": "bash tests/browser/run-in-docker.sh",
    "badge:cov": "npx lcov-badge-generator -o ./badges/coverage.svg ./coverage/lcov.info",
    "check": "./.husky/pre-commit",
    "sandbox": "ts-node ./sandbox.ts",
    "size": "size-limit",
    "node:versions": "node tools/supported-node-versions.cjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "^2.0.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@swc/core": "^1.16.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.3",
    "eslint-plugin-no-underscore": "^0.2.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "pinst": "^3.0.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
